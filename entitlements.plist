<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Builds signed with a Developer ID run under the hardened runtime,
	     which keeps debuggers and injected libraries out of the app, and
	     lets it send Apple Events only with this: to ask browsers for the
	     page they show, for suggestions. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
